{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe-hackathon-2026.invalid/agent-readiness-audit/report.schema.json",
  "title": "Audit report",
  "description": "The single report emitted by audit-orchestrator. The handout's required floor is site, audited_at, a counts-by-severity summary, and findings each carrying id, title, severity, evidence and suggested_action. The remaining top-level keys are the extensions named in docs/CONTRACTS.md section 2: not_assessed and checks_passed are separate arrays so neither inflates total_findings, and run_context states what was crawled against what was discovered so no finding can be attacked as drawn from three pages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "audited_at", "summary", "findings", "not_assessed", "checks_passed", "run_context"],
  "properties": {
    "site": { "type": "string", "minLength": 1 },
    "audited_at": { "$ref": "#/$defs/timestamp" },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },

    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },

    "not_assessed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "reason", "enable_hint"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
          "reason": { "type": "string", "minLength": 1 },
          "enable_hint": { "type": "string", "minLength": 1 }
        }
      }
    },

    "checks_passed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "summary"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },

    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "elapsed_s", "capabilities", "crawl", "sampling", "degradations", "corroboration"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "elapsed_s": { "type": "number", "minimum": 0 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["js_render", "egress", "renderer"],
          "properties": {
            "js_render": { "type": "boolean" },
            "egress": { "type": "boolean" },
            "renderer": { "type": ["string", "null"] }
          }
        },
        "crawl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discovered", "fetched", "blocked_by_robots", "errors"],
          "properties": {
            "discovered": { "type": "integer", "minimum": 0 },
            "fetched": { "type": "integer", "minimum": 0 },
            "blocked_by_robots": { "type": "integer", "minimum": 0 },
            "errors": { "type": "integer", "minimum": 0 }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "strata"],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "strata": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page_type", "discovered", "sampled"],
                "properties": {
                  "page_type": { "type": "string" },
                  "discovered": { "type": "integer", "minimum": 0 },
                  "sampled": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "degradations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "reason", "impact"],
            "properties": {
              "what": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "impact": { "type": "string", "minLength": 1 }
            }
          }
        },
        "corroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "attempted", "frontier_size", "truncated", "provider_unavailable"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "attempted": { "type": "boolean" },
            "frontier_size": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "provider_unavailable": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },

  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
