{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe-hackathon-2026.invalid/agent-readiness-audit/evidence.schema.json",
  "title": "Evidence bundle",
  "description": "The shared observation bundle produced by site-evidence-collector and read by every diagnostic skill. Transcribed field-for-field from docs/CONTRACTS.md section 1, which is frozen. A diagnostic that needs a field absent here has found a contract change, not a missing feature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site",
    "run_context",
    "robots",
    "sitemaps",
    "crawl",
    "pages",
    "link_graph",
    "claim_candidates",
    "canonical_claims",
    "external",
    "ua_probe",
    "well_known",
    "discovery",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },

    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "resolved_origin", "registrable_domain", "detected_locales"],
      "properties": {
        "input": { "type": "string" },
        "resolved_origin": { "type": ["string", "null"] },
        "registrable_domain": { "type": ["string", "null"] },
        "detected_locales": { "type": "array", "items": { "type": "string" } }
      }
    },

    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "capabilities", "budgets", "degradations", "corroboration"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["js_render", "egress", "renderer"],
          "properties": {
            "js_render": { "type": "boolean" },
            "egress": { "type": "boolean" },
            "renderer": { "type": ["string", "null"] }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global_s", "crawl_s", "render_s", "external_s"],
          "properties": {
            "global_s": { "type": "number", "exclusiveMinimum": 0 },
            "crawl_s": { "type": "number", "exclusiveMinimum": 0 },
            "render_s": { "type": "number", "minimum": 0 },
            "external_s": { "type": "number", "minimum": 0 }
          }
        },
        "degradations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "reason", "impact"],
            "properties": {
              "what": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "impact": { "type": "string", "minLength": 1 }
            }
          }
        },
        "corroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "provider_unavailable"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "provider_unavailable": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "robots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetched", "url", "status", "parse_ok", "parse_reason", "groups", "ai_agents", "sitemaps"],
      "properties": {
        "fetched": { "type": "boolean" },
        "parse_ok": {
          "type": "boolean",
          "description": "True only when a real robots.txt was parsed, including an empty one. Separates a valid file with no rules from a webpage served at /robots.txt, which the groups alone cannot."
        },
        "parse_reason": {
          "description": "Why parse_ok has its value. not_plausibly_robots and absent_4xx mean no restrictions apply; unreachable, server_error and rate_limited mean nothing may be crawled. The two families have opposite crawl semantics, so a finding must be able to say which it saw.",
          "enum": ["ok", "not_plausibly_robots", "absent_4xx", "unreachable", "server_error", "rate_limited"]
        },
        "url": { "type": ["string", "null"] },
        "status": { "type": ["integer", "null"] },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_agent", "allow", "disallow", "crawl_delay"],
            "properties": {
              "user_agent": { "type": "string" },
              "allow": { "type": "array", "items": { "type": "string" } },
              "disallow": { "type": "array", "items": { "type": "string" } },
              "crawl_delay": { "type": ["number", "null"] }
            }
          }
        },
        "ai_agents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["GPTBot", "ClaudeBot", "PerplexityBot", "Google-Extended", "OAI-SearchBot", "CCBot", "Googlebot", "Claude-SearchBot"],
          "properties": {
            "GPTBot": { "$ref": "#/$defs/agent_verdict" },
            "ClaudeBot": { "$ref": "#/$defs/agent_verdict" },
            "PerplexityBot": { "$ref": "#/$defs/agent_verdict" },
            "Google-Extended": { "$ref": "#/$defs/agent_verdict" },
            "OAI-SearchBot": { "$ref": "#/$defs/agent_verdict" },
            "CCBot": { "$ref": "#/$defs/agent_verdict" },
            "Googlebot": { "$ref": "#/$defs/agent_verdict" },
            "Claude-SearchBot": { "$ref": "#/$defs/agent_verdict" }
          }
        },
        "sitemaps": { "type": "array", "items": { "type": "string" } }
      }
    },

    "sitemaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "status", "url_count", "lastmod_present_ratio", "parse_ok"],
        "properties": {
          "url": { "type": "string" },
          "status": { "type": ["integer", "null"] },
          "url_count": { "type": ["integer", "null"], "minimum": 0 },
          "lastmod_present_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "parse_ok": { "type": "boolean" }
        }
      }
    },

    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "fetched", "blocked_by_robots", "errors", "sampling"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "fetched": { "type": "integer", "minimum": 0 },
        "blocked_by_robots": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "strata"],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "strata": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page_type", "discovered", "sampled"],
                "properties": {
                  "page_type": { "type": "string" },
                  "discovered": { "type": "integer", "minimum": 0 },
                  "sampled": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },

    "pages": { "type": "array", "items": { "$ref": "#/$defs/page_evidence" } },

    "link_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "orphans", "max_depth_from_home"],
      "properties": {
        "edges": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "orphans": { "type": "array", "items": { "type": "string" } },
        "max_depth_from_home": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "claim_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value_raw", "value_normalized", "source_url", "locator", "extraction_method", "observed_count"],
        "properties": {
          "id": { "type": "string", "pattern": "^CC-[0-9]{3,}$" },
          "kind": { "$ref": "#/$defs/claim_kind" },
          "value_raw": { "type": "string" },
          "value_normalized": { "type": "string" },
          "source_url": { "type": "string" },
          "locator": { "type": "string" },
          "extraction_method": { "enum": ["visible_text", "jsonld", "meta"] },
          "observed_count": { "type": "integer", "minimum": 1 }
        }
      }
    },

    "canonical_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_candidates", "kind", "value_normalized", "first_party_confidence", "entity_ambiguity"],
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
          "from_candidates": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "kind": { "$ref": "#/$defs/claim_kind" },
          "value_normalized": { "type": "string" },
          "first_party_confidence": { "$ref": "#/$defs/confidence" },
          "entity_ambiguity": { "enum": ["low", "medium", "high"] }
        }
      }
    },

    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "method", "frontier_size", "truncated", "origins", "hits"],
      "properties": {
        "attempted": { "type": "boolean" },
        "method": { "type": "string", "minLength": 1 },
        "frontier_size": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "origins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["registrable_domain", "source_type", "urls", "syndication_cluster", "brand_owned"],
            "properties": {
              "registrable_domain": { "type": "string" },
              "source_type": { "$ref": "#/$defs/source_type" },
              "urls": { "type": "array", "items": { "type": "string" } },
              "syndication_cluster": { "type": ["string", "null"] },
              "brand_owned": { "type": "boolean" }
            }
          }
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "origin", "url", "asserted_value", "matches_current", "retrieved_at"],
            "properties": {
              "claim_id": { "type": "string" },
              "origin": { "type": "string" },
              "url": { "type": "string" },
              "asserted_value": { "type": "string" },
              "matches_current": { "type": "boolean" },
              "retrieved_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      }
    },

    "ua_probe": {
      "type": "array",
      "description": "User-agent-conditional serving probe. Each entry names the url it describes, so the same URL can be compared across user agents, which is the only comparison that detects conditional serving; text_hash follows the sha256: convention of raw.text_hash and is the hash of the empty string when no body comes back. Bounded hard at the home page plus one deep page, because this is the one observation that deliberately varies the request identity; repeating it across a sample would be indistinguishable from probing. robots.txt is respected: a disallowed URL is not probed under any user agent.",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "user_agent", "status", "text_len", "text_hash"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "user_agent": { "type": "string", "minLength": 1 },
          "status": { "type": ["integer", "null"] },
          "text_len": { "type": ["integer", "null"], "minimum": 0 },
          "text_hash": { "type": "string", "minLength": 1 }
        }
      }
    },

    "discovery": {
      "type": "object",
      "description": "Structured record of how discovery treated duplicates. errors[] holds free-text diagnostics and is not rule-readable; every fact a rule needs about soft-404 behaviour and collapsed URLs is here.",
      "additionalProperties": false,
      "required": ["soft_404", "collapsed_duplicate_text", "collapsed_redirect_target"],
      "properties": {
        "soft_404": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detected", "baseline_text_hash", "probe_paths"],
          "properties": {
            "detected": { "type": "boolean" },
            "baseline_text_hash": { "type": ["string", "null"] },
            "probe_paths": { "type": "array", "maxItems": 2, "items": { "type": "string" } }
          }
        },
        "collapsed_duplicate_text": { "type": "integer", "minimum": 0 },
        "collapsed_redirect_target": { "type": "integer", "minimum": 0 }
      }
    },

    "well_known": {
      "type": "array",
      "description": "Agent-facing discovery files at the resolved origin. No major assistant is documented to consume them; they are observed so a recommendation about them can be evidence-backed and calibrated as proactive and low priority. Probed once each within 5s, robots-respecting; a disallowed path is not requested and has no entry. Absence is an observation, not an error. Existence and shape only, never contents.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "present", "content_type"],
        "properties": {
          "path": { "enum": ["/llms.txt", "/agents.md", "/.well-known/ucp"] },
          "status": { "type": ["integer", "null"] },
          "present": { "type": "boolean" },
          "content_type": { "type": ["string", "null"] }
        }
      }
    },

    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "stage", "message"],
        "properties": {
          "url": { "type": "string" },
          "stage": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "agent_verdict": { "enum": ["allowed", "disallowed", "unspecified"] },
    "page_type": {
      "description": "Closed vocabulary. A rule branching on page_type == \"product\" fails silently and permanently if the collector writes \"products\", so the value set is a contract, not a convention. \"other\" is a real classification carrying a low page_type_confidence, not a failure marker.",
      "enum": ["home", "product", "category", "article", "about", "contact", "policy", "doc", "other"]
    },
    "layer": { "enum": ["first_party", "third_party"] },
    "source_type": {
      "enum": ["encyclopedic", "retailer", "directory", "news", "review", "forum", "social"]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "claim_kind": {
      "enum": ["tagline", "legal_name", "founded_year", "price", "address", "product_name", "numeric_claim"]
    },
    "text_path": {
      "type": "string",
      "description": "Relative path to the extracted-text sidecar, evidence/pages/<sha256>.txt. Named by content hash, so two pages with identical extracted text share one file and a bundle stays diffable.",
      "pattern": "^evidence/pages/[0-9a-f]{8,64}\\.txt$"
    },
    "text_path_or_null": {
      "type": ["string", "null"],
      "description": "As text_path, but null when no render happened, so that an absent render stays distinguishable from an empty one.",
      "pattern": "^evidence/pages/[0-9a-f]{8,64}\\.txt$"
    },
    "anchor": {
      "type": "object",
      "description": "An in-page fragment target a deep link can address, paired with the heading it labels. An assistant citing a passage can only link to it if the passage has an addressable id.",
      "additionalProperties": false,
      "required": ["id", "heading_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "heading_text": { "type": "string" }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" }
      }
    },

    "page_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url", "final_url", "status", "redirect_chain", "content_type", "fetched_at",
        "headers", "meta_robots", "canonical", "canonical_self", "lang", "hreflang",
        "page_type", "page_type_confidence", "raw", "rendered", "jsonld",
        "microdata_or_rdfa", "text", "dates", "obstructions", "timing", "provenance"
      ],
      "properties": {
        "url": { "type": "string" },
        "final_url": { "type": "string" },
        "status": { "type": ["integer", "null"] },
        "redirect_chain": { "type": "array", "items": { "type": "string" } },
        "content_type": { "type": ["string", "null"] },
        "fetched_at": { "$ref": "#/$defs/timestamp" },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_robots_tag", "last_modified", "cache_control"],
          "properties": {
            "x_robots_tag": { "type": ["string", "null"] },
            "last_modified": { "type": ["string", "null"] },
            "cache_control": { "type": ["string", "null"] }
          }
        },
        "meta_robots": { "type": "array", "items": { "type": "string" } },
        "canonical": { "type": ["string", "null"] },
        "canonical_self": { "type": "boolean" },
        "lang": { "type": ["string", "null"] },
        "hreflang": { "type": "array", "items": { "type": "string" } },
        "page_type": { "$ref": "#/$defs/page_type" },
        "page_type_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "text_len", "text_hash", "text_path", "headings", "anchors", "links", "images", "tables", "iframes", "forms"],
          "properties": {
            "bytes": { "type": "integer", "minimum": 0 },
            "text_len": { "type": "integer", "minimum": 0 },
            "text_hash": { "type": "string" },
            "text_path": { "$ref": "#/$defs/text_path" },
            "headings": { "type": "array", "items": { "$ref": "#/$defs/heading" } },
            "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
            "links": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["href", "rel", "anchor", "internal"],
                "properties": {
                  "href": { "type": "string" },
                  "rel": { "type": ["string", "null"] },
                  "anchor": { "type": "string" },
                  "internal": { "type": "boolean" }
                }
              }
            },
            "images": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src", "alt", "text_likely"],
                "properties": {
                  "src": { "type": "string" },
                  "alt": { "type": ["string", "null"] },
                  "text_likely": { "type": "boolean" }
                }
              }
            },
            "tables": { "type": "integer", "minimum": 0 },
            "iframes": { "type": "integer", "minimum": 0 },
            "forms": { "type": "integer", "minimum": 0 }
          }
        },
        "rendered": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "text_len", "text_hash", "text_path", "headings", "delta_ratio"],
          "properties": {
            "available": { "type": "boolean" },
            "text_len": { "type": ["integer", "null"], "minimum": 0 },
            "text_hash": { "type": ["string", "null"] },
            "text_path": { "$ref": "#/$defs/text_path_or_null" },
            "headings": { "type": "array", "items": { "$ref": "#/$defs/heading" } },
            "delta_ratio": { "type": ["number", "null"] }
          }
        },
        "jsonld": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "valid", "errors", "fields_present", "values", "contradicts_visible_text"],
            "properties": {
              "type": { "type": "string" },
              "valid": { "type": "boolean" },
              "errors": { "type": "array", "items": { "type": "string" } },
              "fields_present": { "type": "array", "items": { "type": "string" } },
              "values": {
                "type": "object",
                "description": "Flat map of dotted path to string value, so a rule can compare what the markup asserts against what the visible text says without re-parsing the block. Capped at 4KB per page across all blocks; on overflow the collector keeps the shortest values first, since the fields worth cross-checking are short ones.",
                "additionalProperties": { "type": "string" }
              },
              "contradicts_visible_text": { "type": "boolean" }
            }
          }
        },
        "microdata_or_rdfa": { "type": "boolean" },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_excerpt", "word_count", "boilerplate_ratio", "longest_block_words", "heading_density_per_1k"],
          "properties": {
            "visible_excerpt": { "type": "string", "maxLength": 2000 },
            "word_count": { "type": "integer", "minimum": 0 },
            "boilerplate_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "longest_block_words": { "type": "integer", "minimum": 0 },
            "heading_density_per_1k": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_dates", "schema_date_modified", "schema_date_published", "http_last_modified"],
          "properties": {
            "visible_dates": { "type": "array", "items": { "type": "string" } },
            "schema_date_modified": { "type": ["string", "null"] },
            "schema_date_published": { "type": ["string", "null"] },
            "http_last_modified": { "type": ["string", "null"] }
          }
        },
        "obstructions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "evidence"],
            "properties": {
              "kind": { "enum": ["cookie_wall", "modal", "paywall", "age_gate"] },
              "evidence": { "type": "string" }
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ttfb_ms", "fetch_ms", "render_ms"],
          "properties": {
            "ttfb_ms": { "type": ["number", "null"], "minimum": 0 },
            "fetch_ms": { "type": ["number", "null"], "minimum": 0 },
            "render_ms": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "method"],
          "properties": {
            "layer": { "$ref": "#/$defs/layer" },
            "method": { "enum": ["fetch", "render"] }
          }
        }
      }
    }
  }
}
